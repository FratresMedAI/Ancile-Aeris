<?xml version="1.0" ?>
<!-- Gazebo Harmonic world matching clearsky_os_sim.kinematics (inbound UAS vs asset).
     Launch with: gz sim -r share/clearsky_os_sim/worlds/clearsky_cuas.sdf
     CI uses the kinematics bridge when Gazebo is not installed. -->
<sdf version="1.9">
  <world name="clearsky_cuas">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="protected_asset">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>25</radius><length>2</length></cylinder></geometry>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>25</radius><length>2</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <!-- Initial pose matches kinematics.truth_at(t=0) defaults -->
    <model name="uas_inbound_01">
      <pose>180 40 60 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.02</ixx><iyy>0.02</iyy><izz>0.04</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.25</size></box></geometry>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.8 0.8 0.25</size></box></geometry>
        </collision>
      </link>
      <!-- Constant velocity plugin placeholder; bridge may drive pose externally -->
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <linear> -12 2 0 </linear>
      </plugin>
    </model>
  </world>
</sdf>
