  <exec_depend>clearsky_os_sensors</exec_depend>
  <exec_depend>clearsky_os_sim</exec_depend>
  <exec_depend>clearsky_os_sensor_resilience</exec_depend>
  <exec_depend>clearsky_os_swarm_intent</exec_depend>
  <exec_depend>clearsky_os_scout_mothership</exec_depend>
  <exec_depend>clearsky_os_micro_payloads</exec_depend>
  <exec_depend>clearsky_os_baby_interceptor</exec_depend>
  <exec_depend>clearsky_os_effectors</exec_depend>
  <exec_depend>agent_orchestrator</exec_depend>
  <exec_depend>digital_twin</exec_depend>
  <exec_depend>cognitive_ew</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
