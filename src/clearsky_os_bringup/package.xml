  <exec_depend>clearsky_os_darkspace_integration</exec_depend>
  <exec_depend>clearsky_os_fusion</exec_depend>
  <exec_depend>clearsky_os_integration</exec_depend>
  <exec_depend>clearsky_os_interfaces</exec_depend>
