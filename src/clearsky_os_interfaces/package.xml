<?xml version="1.0"?>
<package format="3">
  <name>clearsky_os_interfaces</name>
  <version>0.1.0</version>
  <description>Shared messages, services, and actions for ClearSky OS Cognitive Defensive Shield.</description>
  <maintainer email="maintainers@fratres-x.ai">ClearSky-OS Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
